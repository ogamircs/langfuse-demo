# ---- Anthropic (Claude Agent SDK reads this from the environment) ----
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-sonnet-5
AGENT_EFFORT=medium
AGENT_MAX_TURNS=25
AGENT_MAX_BUDGET_USD=1.00
# default | acceptEdits | bypassPermissions (not allowed as root)
AGENT_PERMISSION_MODE=default

# ---- Langfuse (default path: Langfuse Cloud) ----
# EU: https://cloud.langfuse.com   US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=v0.1.0
# LANGFUSE_SAMPLE_RATE=1.0
# LANGFUSE_TRACING_ENABLED=true
# LANGFUSE_DEBUG=false

# ---- Self-hosted alternative (docker compose -f docker-compose.langfuse.yml up) ----
# LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-demo-public-key
# LANGFUSE_SECRET_KEY=sk-lf-demo-secret-key

# ---- Demo behaviour ----
DEMO_DB_PATH=data/demo.duckdb
DEMO_DEFAULT_USER=analyst.amir
DEMO_MASK_PII=true
